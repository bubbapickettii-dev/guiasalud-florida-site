[TEMPLATE]
# Copy to .env (never commit .env). Going live = filling these in; no code changes.
LEADENGINE_ENV=production            # turns on safety guards: strong admin token required, demo buyers hidden from real traffic
BASE_URL=                            # optional: the host's assigned origin is used when empty (Render: RENDER_EXTERNAL_URL,
                                     # e.g. https://giasalud.onrender.com). Set it to the canonical domain once one exists.
ADMIN_TOKEN=                          # 16+ random chars. Admin: /admin?token=...
ALLOW_INDEXING=0                      # 1 = let Google index /check, /learn, /aprende (only after counsel review)
LEADENGINE_LIVE_DELIVERY=0            # 1 = actually send lead emails/webhooks + Meta CAPI. 0 = dry run to outbox/
LEADENGINE_IP_LEADS_PER_HOUR=30       # public-write throttle: max non-test /api/lead submissions per source IP per hour
LEADENGINE_IP_EVENTS_PER_HOUR=120     # analytics flood cap: max /api/event writes per visitor id per hour
LEADENGINE_DB=/data/leads.db          # must be on a persistent disk
LEADENGINE_STORAGE=persistent         # persistent|ephemeral. On a host with no disk say `ephemeral`: the app then runs a
                                      # READ-ONLY public preview and refuses submissions it could not keep, instead of losing
                                      # leads/consent/payment rows (see docs/RENDER_DEPLOY.md)
INTEL_DB=                             # leave EMPTY in production. The public-record DB stays on your machine; briefs ship as config/regional_briefs.json

# Business identity (footer, privacy, terms, contact). Set once here or in config/site.json — the app reads
# one helper (app.business_identity). A value that is empty or bracketed is treated as NOT SUPPLIED and is
# never printed. Do not invent a street address, an LLC/Inc. suffix, a registration number or a phone.
BRAND="Gia Salud"
LEGAL_ENTITY="Gia Salud"
LOCATION="Miami, Florida"
FOUNDED="Miami, Florida"
SUPPORT_EMAIL=                        # ONLY once a real inbox exists (the live service uses giasaludellc@gmail.com, set in the host, not here).
                                      # While empty, /contact shows the on-site form and no address is displayed.
CONTACT_EMAIL=                        # alias, read the same way; leave blank when SUPPORT_EMAIL is set
MAILING_ADDRESS=                      # optional: not required for this website
SUPPORT_PHONE=                        # optional: contact page only

# Lead delivery email (agent alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=leads@YOUR-DOMAIN.com

# Discovery: provider-sanctioned search API. The one channel that reaches public posts where a
# person published an email/phone NEXT TO a coverage ask. Free tier is enough to start.
#   Bing Web Search v7 (portal.azure.com, F1 = 1,000 calls/month)
BING_SEARCH_KEY=
#   alternatives (pick one provider in config/sources.json > discovery > websearch > provider)
BRAVE_SEARCH_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Tracking (optional; leave blank until approved)
META_PIXEL_ID=
META_CAPI_TOKEN=
GA4_ID=
